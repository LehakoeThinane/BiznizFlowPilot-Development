# Copy to .env.production on the Oracle VM and fill in real values.
# Never commit the real .env.production file.

APP_NAME=BiznizFlowPilot
DEBUG=false
ENVIRONMENT=production

# Supabase: Settings -> Database -> Connection string -> "Transaction pooler"
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# Generate distinct random secrets for these two - do not reuse dev values.
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
PLATFORM_SECRET_KEY=

# Upstash: dashboard -> Redis database -> "Redis Connect" -> rediss:// URL
# Reuse the same Upstash URL for all three, with different db index if using
# a self-hosted Redis; Upstash only exposes db 0, so point all three at it.
REDIS_URL=rediss://default:PASSWORD@xxxx.upstash.io:6379
CELERY_BROKER_URL=rediss://default:PASSWORD@xxxx.upstash.io:6379
CELERY_RESULT_BACKEND=rediss://default:PASSWORD@xxxx.upstash.io:6379

# Vercel-hosted frontend
FRONTEND_URL=https://app.mmnexus.co.za

# Marketing site + app frontend origins allowed to call this API
CORS_ORIGINS=https://mmnexus.co.za,https://www.mmnexus.co.za,https://app.mmnexus.co.za

API_BASE_URL=https://api.mmnexus.co.za

# Stripe (dashboard.stripe.com -> Developers -> API keys / Webhooks)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_IDS={"starter":"price_xxx","professional":"price_xxx","enterprise":"price_xxx"}

# Email (Resend recommended - resend.com)
RESEND_API_KEY=

# AI provider (optional)
AI_PROVIDER=echo
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Agora (only needed if using voice/video meetings)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
