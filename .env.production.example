# Copy to .env.production on the VM and fill in real values.
# Never commit the real .env.production file.

APP_NAME=BiznizFlowPilot
DEBUG=false
ENVIRONMENT=production

# Supabase: Settings -> Database -> Connection string -> "Transaction pooler"
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# Generate distinct random secrets for these three - do not reuse dev values.
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
PLATFORM_SECRET_KEY=
MARKETING_CMS_SECRET_KEY=

# MM Nexus marketing blog CMS - GitHub PAT authorizing the "Publish" button's
# commit to MM-Nexus-Website. Generate a fine-grained token (GitHub ->
# Settings -> Developer settings -> Fine-grained tokens) scoped to ONLY the
# MM-Nexus-Website repo, with Contents: Read and write permission - nothing else.
MARKETING_CMS_GITHUB_PAT=
MARKETING_CMS_GITHUB_REPO=LehakoeThinane/MM-Nexus-Website
MARKETING_CMS_GITHUB_BRANCH=main

# Daily blog autopublish - off by default. Flip to true once topics are
# queued and AI_PROVIDER is a real engine (not "echo").
MARKETING_BLOG_AUTOPUBLISH_ENABLED=false
MARKETING_BLOG_AUTOPUBLISH_REQUIRES_APPROVAL=false
MARKETING_SITE_ADMIN_URL=https://mmnexus.co.za/admin/blog/edit
MARKETING_SITE_PUBLIC_URL=https://mmnexus.co.za

# LinkedIn company-page cross-posting - leave both blank until the
# Community Management API product (w_organization_social scope) is
# actually approved for the app; see app/integrations/linkedin.py.
LINKEDIN_ORGANIZATION_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_URN=

# Redis Cloud (or any Redis provider): dashboard -> database -> Connect ->
# redis-cli command shows the full URL. Reuse the same URL for all three.
REDIS_URL=redis://default:PASSWORD@xxxx.cloud.redislabs.com:PORT
CELERY_BROKER_URL=redis://default:PASSWORD@xxxx.cloud.redislabs.com:PORT
CELERY_RESULT_BACKEND=redis://default:PASSWORD@xxxx.cloud.redislabs.com:PORT

# Frontend (runs as its own container on the same VM)
FRONTEND_URL=https://app.mmnexus.co.za

# Marketing site + app frontend origins allowed to call this API.
# Must be JSON-array format, not comma-separated - docker-compose's
# env_file: injects this as a real environment variable, which bypasses the
# app's comma-separated dotenv parsing and falls back to strict JSON decoding.
CORS_ORIGINS=["https://mmnexus.co.za","https://www.mmnexus.co.za","https://app.mmnexus.co.za"]

API_BASE_URL=https://api.mmnexus.co.za

# Stripe (dashboard.stripe.com -> Developers -> API keys / Webhooks)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_IDS={"starter":"price_xxx","professional":"price_xxx","enterprise":"price_xxx"}

# Email (Resend recommended - resend.com)
RESEND_API_KEY=

# AI provider (optional) - echo | ollama | anthropic | groq
# Scheduled lead-gen follow-up emails (app/services/lead_followup.py) refuse
# to send while this is "echo" - a templated email would defeat the point
# of "tailored, not generic". Groq has a real free tier - a reasonable
# default before paying for Anthropic, given zero revenue right now.
AI_PROVIDER=echo
ANTHROPIC_API_KEY=
GROQ_API_KEY=
# Use a lightweight Groq model under 4B parameters for the ERP co-pilot.
GROQ_MODEL=llama-3.2-3b-preview
# Perplexity - only used as a web-search tool when AI_PROVIDER=groq
PERPLEXITY_API_KEY=

# AI-generated blog cover images (platform.openai.com -> API keys) - separate
# from AI_PROVIDER above, only used for image generation, not chat.
OPENAI_API_KEY=

# MM Nexus website chat widget (see app/services/website_chat.py) - the BFP
# business/tenant these conversations belong to, and the staff User id
# seated as the second conversation participant. Find both via BFP's own
# UI/API once logged in as that business.
MM_NEXUS_BUSINESS_ID=
MM_NEXUS_CHAT_ASSIGNEE_USER_ID=

# Agora (only needed if using voice/video meetings)
# Copy these to the VM's real .env.production file before restarting the stack.
AGORA_APP_ID=a91125fd5d1b4192960a583daf9fda6b
AGORA_APP_CERTIFICATE=5d44c29d9b524272ab35b5847cff5d9d

# Sentry error tracking (sentry.io -> create a Python/FastAPI project -> Settings -> Client Keys (DSN))
SENTRY_DSN=

# Lead-gen automation
# Google Cloud Console -> APIs & Services -> Credentials (Places API (New) enabled)
GOOGLE_PLACES_API_KEY=
# apollo.io -> Settings -> Integrations -> API
APOLLO_API_KEY=

# Scheduled lead-gen (Mon/Wed/Thu 07:00 SAST) - off by default. Add saved
# searches via POST /api/v1/leads/schedules, then flip this to true.
LEAD_GEN_SCHEDULE_ENABLED=false

# Lead-reply escalation - polls every connected mailbox (Email page) every
# 30 min for a reply from a lead-gen-sourced lead, flips it to "contacted"
# and notifies staff to take over personally. Needs at least one mailbox
# connected via the Email page first, then flip this to true.
LEAD_REPLY_WATCH_ENABLED=false

# Inbox for marketing-lead and onboarding-help-request notifications
STAFF_NOTIFICATION_EMAIL=

# Google Sign-In for the public trial-signup flow.
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (Web application). Only the client ID is needed here - no client secret.
# Must match NEXT_PUBLIC_GOOGLE_CLIENT_ID baked into the frontend image.
GOOGLE_CLIENT_ID=795548595411-27qudji6jgbgciqnrffltqgd216mca8f.apps.googleusercontent.com
